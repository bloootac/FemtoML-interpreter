Grammar

    0 $accept: program $end

    1 program: ε
    2      | expr `;;` program
    3      | decl `;;` program

    4 expr: NUM
    5      | CHAR
    6      | ID
    7      | `(` expr `)`
    8      | `<` ID `,` `[` S_1 `]` `>`
    9      | `\` ID `.` expr
   10      | `\` `(` S_2 `)`
   11      | `let` decl `in` expr

   12 pattern: expr `->` expr

   13 type_expr: type_expr_body
   14      | `@` S_3 `.` type_expr

   15 type_expr_body: `Num`
   16      | `Char`
   17      | ID
   18      | `Constructor` `[` S_4 `]`
   19      | type_expr_body `->` type_expr_body
   20      | `(` type_expr `)`

   21 decl: ID `=` expr
   22      | decl `and` decl
   23      | decl `;` decl
   24      | `rec` ID `=` expr
   25      | ID `:` type_expr

   26 S_1_L: expr
   27      | S_1_L `,` expr

   28 S_1: ε
   29      | S_1_L

   30 S_2_L: pattern
   31      | S_2_L `|` pattern

   32 S_2: ε
   33      | S_2_L

   34 S_3_L: ID
   35      | S_3_L `,` ID

   36 S_3: ε
   37      | S_3_L

   38 S_4_L: type_expr_body
   39      | S_4_L `,` type_expr_body

   40 S_4: ε
   41      | S_4_L


