%notation FemtoML
%package femtoml
%tables lalr

/*
expr:
	- Num number                          | 5067
	- Char char                           | c
	- Constructor string [expr]           | <"s", [e1, ..., eN]>
	- Identifier string                   | val
	- Apply expr expr                     | e1 e2
	- Fun identifier expr                 | \ i . e
	- CaseFun [(expr, expr)]              | \ ( p1 -> b1 | ... | pN -> bN)
	- Let decl expr                       | let d in e 

type_expr:
	- NumType                             | Num
	- CharType                            | Char
	- ConstructorType [type_exprs]        | Constructor [t1, ..., tN]
	- FunType type_expr type_expr         | t1 -> t2
	- PolyType [identifier] type_expr     | @ i1, ..., iN. t
	
	

decl:
	- ValDec identifier expr              | i = e 
	- AndDec decl decl                    | d1 and d2
	- SeqDec decl decl                       | d1 ; d2
	- RecDec decl                         | rec d
	- HasType identifier type_expr        | i : e
*/


%token NUM(Long) CHAR(Char) ID(String) `(` `)` `[` `]` `,` `<` `>`
%token `let` `in` `\` `.` `|`
%token `Num` `Char` `Constructor` `@`
%token `=` `and` `rec` `:`
%left ';' `and`
%right `->`

%rules

%include {
	import femtoml.AST._
}


expr: Expr = Num		{ Num($NUM) }
           | CHAR		{ Character($CHAR) }
           | ID                 { Identifier($ID)  }
           | `(` expr `)`       { $expr }
           | `<` ID `,` `[` args: (expr `,`)* `]` `>`
           			{ Constructor($ID, $args) }
           | `\` ID `.` expr    { Fun($ID, $expr) }
           | `\` `(` cases: ((expr1:expr `->` expr2:expr) `|`)* `)`
				{ CaseFun($cases) }
	   | `let` decl `in` expr 
	   			{ Let($decl, $expr) }

type_expr: TypeExpr = 
             `Num`              { NumType }
           | `Char`             { CharType }
           | `Constructor` `[` args: (type_expr `,`)* `]` 
           			{ ConstructorType($args) }
           | a:type_expr `->` b:type_expr
           			{ FunType($a, $b) }
           | `@` `[` args:(ID `,`)* `]`
           			{ PolyType($args) }

decl: Decl =
	   | ID `=` expr	{ ValDec($ID, $expr) }
	   | a:decl `and` b:decl
	   			{ AndDec($a, $b) }
	   | a:decl `;` b:decl  { SeqDec($a, $b) }
	   | `rec` decl		{ RecDec($decl) }
	   | ID `:` type_expr	{ HasType($ID, $type_expr }

