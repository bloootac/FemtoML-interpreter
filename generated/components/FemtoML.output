   18 type_expr_body: `Num`
   19      | `Char`
   20      | ID
   21      | `Constructor` `[` S_4 `]`
   22      | type_expr_body `->` type_expr_body
   23      | `(` type_expr `)`

   24 decl: ID `=` expr
   25      | decl `and` decl
   26      | decl `;` decl
   27      | `rec` ID `=` expr
   28      | ID `:` type_expr

   29 S_1_L: pattern
   30      | S_1_L `|` pattern

   31 S_1: ε
   32      | S_1_L

   33 S_2_L: expr
   34      | S_2_L `,` expr

   35 S_2: ε
   36      | S_2_L

   37 S_3_L: ID
   38      | S_3_L `,` ID

   39 S_3: ε
   40      | S_3_L

   41 S_4_L: type_expr_body
   42      | S_4_L `,` type_expr_body

   43 S_4: ε
   44      | S_4_L


